# Spa Rivier — Supabase Studio behind the admin portal's login.
#
# The api.sparivier.ca block of the server's Caddyfile (/etc/caddy/Caddyfile),
# as switch-studio-login.sh installs it. The public API passes straight
# through as before. Everything else is Studio: Caddy first asks the
# studio-gate function (functions/studio-gate) whether the browser's
# sr_studio cookie belongs to an admin with Studio access, then adds Studio's
# own credential (the gateway's basic auth, DASHBOARD_USERNAME and
# DASHBOARD_PASSWORD in Supabase's .env) so nobody types it.
#
# That credential is in /etc/caddy/studio-auth.caddy (root:caddy, mode 640),
# one line: header_up Authorization "Basic <base64 of user:password>". It is
# never in this repo. The gateway (Envoy, service api-gw) listens only on
# 127.0.0.1:8000, so Studio cannot be reached around this check.

api.sparivier.ca {
	@api path /auth/v1/* /rest/v1/* /storage/v1/* /functions/v1/* /realtime/v1/* /graphql/v1* /pg/* /.well-known/*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		forward_auth 127.0.0.1:8000 {
			uri /functions/v1/studio-gate
			copy_headers X-Studio-User
		}
		reverse_proxy 127.0.0.1:8000 {
			import /etc/caddy/studio-auth.caddy
		}
	}
}
